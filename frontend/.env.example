# Local dev: leave VITE_API_URL unset. The Vite dev proxy (vite.config.js)
# forwards /api, /uploads and /socket.io to http://localhost:5000 for you.
#
# Production (Vercel): set VITE_API_URL to your deployed Render backend's
# own origin, no trailing slash and no /api, e.g.
# VITE_API_URL=https://retailhub-api.onrender.com
VITE_API_URL=
